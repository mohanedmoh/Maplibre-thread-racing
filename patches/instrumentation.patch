     private val regions = HashMap<String, OfflineRegion>()
 
+    @Volatile private var reproAmbientDone = false
+
+    // REPRO watchdog: if setMaximumAmbientCacheSize has not called back after
+    // 6 s, dump every thread's stack so a hang shows who is waiting on whom.
+    private fun startReproWatchdog() {
+        val t = Thread({
+            try {
+                Thread.sleep(6000)
+            } catch (e: InterruptedException) {
+                return@Thread
+            }
+            if (reproAmbientDone) {
+                Log.i("REPRO", "watchdog: ambient cache callback already fired, no dump needed")
+                return@Thread
+            }
+            Log.i("REPRO", "watchdog: NO ambient cache callback after 6 s, dumping all threads")
+            for ((th, st) in Thread.getAllStackTraces()) {
+                Log.i("REPRO_DUMP", "\"${th.name}\" tid=${th.id} state=${th.state}")
+                for (e in st) Log.i("REPRO_DUMP", "    at $e")
+            }
+        }, "repro-watchdog")
+        t.isDaemon = true
+        t.start()
+    }
+
     override fun initialize() {
+        startReproWatchdog()
+        Log.i("REPRO", "OfflineModule.initialize() on ${Thread.currentThread().name}: posting runMigrations to the main looper")
         Handler(Looper.getMainLooper()).post {
+            Log.i("REPRO", "runMigrations START on ${Thread.currentThread().name}")
             runMigrations()
         }
     }
