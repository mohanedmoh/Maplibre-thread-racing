+package org.maplibre.reactnative.utils
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import org.maplibre.android.MapLibre
+import java.util.concurrent.CountDownLatch
+
+/**
+ * Guarantees that MapLibre.getInstance has completed before anything touches
+ * FileSource or OfflineManager.
+ *
+ * MapLibre.getInstance must run on the main thread, and it is what makes
+ * MapLibre.validateMapLibre() pass and what loads libmaplibre.so. Callers on
+ * other threads (React Native's native modules thread) hop to the main thread
+ * and wait, so they can neither hit MapLibreConfigurationException nor start
+ * loading the native library concurrently with the main thread.
+ */
+object MapLibreInitializer {
+    private val initialized = CountDownLatch(1)
+
+    @JvmStatic
+    fun ensureInitialized(context: Context) {
+        if (initialized.count == 0L) return
+
+        if (Looper.myLooper() == Looper.getMainLooper()) {
+            initializeOnMainThread(context)
+        } else {
+            Handler(Looper.getMainLooper()).post { initializeOnMainThread(context) }
+            initialized.await()
+        }
+    }
+
+    private fun initializeOnMainThread(context: Context) {
+        if (initialized.count == 0L) return
+
+        MapLibre.getInstance(context.applicationContext)
+        initialized.countDown()
+    }
+}
